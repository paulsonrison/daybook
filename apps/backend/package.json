{
  "name": "@daybook/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "worker": "node --import tsx src/worker.ts",
    "worker:start": "node dist/worker.js",
    "communications:worker": "node --import tsx src/communications-worker.ts",
    "communications:worker:start": "node dist/communications-worker.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node ../../scripts/backend-unit-tests.mjs",
    "db:check": "node --import tsx src/db/check.ts",
    "db:migrate": "node --import tsx src/db/migrate.ts",
    "test:integration": "node ../../scripts/test-database.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1169.0",
    "@daybook/ui": "^0.1.0",
    "csv-parse": "7.0.3",
    "dotenv": "^17.2.3",
    "fflate": "0.8.3",
    "graphql": "^16.11.0",
    "graphql-yoga": "^5.16.0",
    "pg": "^8.16.3",
    "playwright-core": "^1.65.0",
    "qrcode": "^1.5.4",
    "twilio": "^6.3.0",
    "write-excel-file": "4.1.1"
  },
  "devDependencies": {
    "@types/pg": "^8.15.6",
    "@types/qrcode": "^1.5.6",
    "embedded-postgres": "^17.11.0-beta.19",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.20.6"
  }
}
