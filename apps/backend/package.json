{
  "name": "@daybook/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test src/app.test.ts",
    "db:check": "node --import tsx src/db/check.ts",
    "db:migrate": "node --import tsx src/db/migrate.ts"
  },
  "dependencies": {
    "graphql": "^16.11.0",
    "graphql-yoga": "^5.16.0",
    "pg": "^8.16.3",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "tsx": "^4.20.6",
    "@types/pg": "^8.15.6"
  }
}
