{
  "name": "@daybook/ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "files": [
    "src",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./fonts.css": "./src/fonts.css",
    "./tokens": "./src/tokens.ts",
    "./assets": "./src/assets.ts",
    "./examples": "./src/examples.tsx",
    "./assets/*": "./src/assets/*",
    "./money": {
      "types": "./src/money.d.ts",
      "default": "./src/money.js"
    },
    "./documents": {
      "types": "./src/documents.d.ts",
      "default": "./src/documents.js"
    },
    "./preferences": {
      "types": "./src/preferences.d.ts",
      "default": "./src/preferences.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node tests/run.mjs",
    "lint": "eslint .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/react-vite": "^10.6.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.6",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.2.2"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/noto-sans-devanagari": "^5.3.0",
    "@fontsource-variable/noto-sans-malayalam": "^5.3.0",
    "@fontsource-variable/nunito-sans": "^5.3.0"
  }
}
