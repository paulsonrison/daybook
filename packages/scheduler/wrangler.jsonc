{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "daybook-free-scheduler",
  "main": "scheduler.mjs",
  "compatibility_date": "2026-11-18",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["7 * * * *"] },
  "vars": {
    "DAYBOOK_ORIGIN": "https://daybook-paulson-preview-o1c8.onrender.com",
  },
  "observability": { "enabled": true },
}
